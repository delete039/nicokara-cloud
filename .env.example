# Backend
NICOKARA_DATA_DIR=./data
NICOKARA_STORAGE_DIR=../storage/jobs
NICOKARA_MAX_VIDEO_BYTES=1073741824
NICOKARA_MAX_LYRICS_BYTES=1048576
NICOKARA_MAX_PENDING_JOBS=4
NICOKARA_MAX_ACTIVE_JOBS_PER_CLIENT=2
NICOKARA_CLEANUP_ENABLED=true
NICOKARA_JOB_RETENTION_HOURS=24
NICOKARA_CLEANUP_INTERVAL_SECONDS=3600
NICOKARA_ALLOWED_ORIGINS=http://localhost:3000
NICOKARA_TRUSTED_PROXY_HOSTS=127.0.0.1,::1
NICOKARA_PROCESSING_ENABLED=true
NICOKARA_FFMPEG_PATH=ffmpeg
NICOKARA_FFMPEG_TIMEOUT_SECONDS=900
NICOKARA_VIDEO_RENDER_TIMEOUT_SECONDS=7200
NICOKARA_VIDEO_RENDER_PRESET=veryfast
NICOKARA_VIDEO_RENDER_CRF=20
NICOKARA_WHISPER_MODEL=small
NICOKARA_WHISPER_DEVICE=cpu
NICOKARA_WHISPER_COMPUTE_TYPE=int8
NICOKARA_VOCAL_REMOVAL_BACKEND=mdx
NICOKARA_VOCAL_REMOVAL_MODEL=UVR_MDXNET_KARA_2.onnx
NICOKARA_VOCAL_REMOVAL_MODEL_DIR=./data/audio-separator-models
NICOKARA_DEEPSEEK_API_KEY=
NICOKARA_DEEPSEEK_BASE_URL=https://api.deepseek.com
NICOKARA_DEEPSEEK_MODEL=deepseek-v4-flash
NICOKARA_DEEPSEEK_TIMEOUT_SECONDS=60

# Frontend (local dev already proxies /api to the backend)
NEXT_PUBLIC_API_URL=/api/v1
NICOKARA_DEV_API_ORIGIN=http://127.0.0.1:8000
